{
  "name": "@streamshapers/ograf-validator-app",
  "version": "0.2.1",
  "description": "OGraf Validator – browser-based tool for validating, inspecting and safely previewing OGraf Graphics Packages",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint src e2e public vite.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rollup/browser": "^4.62.4",
    "@streamshapers/ograf-validator-core": "*",
    "lucide-react": "^1.30.0",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
