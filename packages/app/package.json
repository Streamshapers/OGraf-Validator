{
  "name": "@streamshapers/ograf-validator-app",
  "version": "0.3.1",
  "description": "OGraf Validator \u2013 browser-based tool for validating, inspecting and safely previewing OGraf Graphics Packages",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint src e2e public vite.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rollup/browser": "^4.67.5",
    "@streamshapers/ograf-validator-core": "*",
    "lucide-react": "^1.69.0",
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "lottie-web": "5.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  }
