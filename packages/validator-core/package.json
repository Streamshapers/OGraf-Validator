{
  "name": "@streamshapers/ograf-validator-core",
  "version": "0.2.0",
  "description": "Validate OGraf v1 Graphics Packages in Node.js and browsers with zero runtime dependencies",
  "keywords": ["ograf", "broadcast", "graphics", "validator", "ebu"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Streamshapers/OGraf-Validator.git",
    "directory": "packages/validator-core"
  },
  "homepage": "https://github.com/Streamshapers/OGraf-Validator/tree/master/packages/validator-core#readme",
  "bugs": {
    "url": "https://github.com/Streamshapers/OGraf-Validator/issues"
  },
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist", "spec", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.cjs.json && node scripts/finalize-dist.mjs",
    "dev": "tsc -p tsconfig.build.esm.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:validator": "node scripts/generate-standalone-validator.mjs",
    "spec:check": "node scripts/check-spec.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "8.20.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
